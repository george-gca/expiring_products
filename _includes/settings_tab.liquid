<div class="tab-pane fade" id="options-tab-pane" role="tabpanel" aria-labelledby="options-tab" tabindex="9">
  <div class="row mt-3">
    <div class="col-sm-12">
      <h5>{{ page.manage_categories }}</h5>
      <div class="mb-3">
        <div class="input-group">
          <input type="text" class="form-control" id="new-category-name" placeholder="{{ page.category_name }}">
          <button class="btn btn-outline-primary" type="button" id="add-category-btn">
            <i class="fa-solid fa-plus"></i> {{ page.add_category }}
          </button>
        </div>
      </div>

      <div id="categories-list" class="mb-4">
        <!-- Categories will be populated dynamically -->
      </div>

      <hr>

      <input type="button" id="export-products-input" class="d-none"/>
      <label for="export-products-input" class="btn">{{ page.export_data }}</label>
      <input type="file" id="import-products-input" accept=".json" class="d-none"/>
      <label for="import-products-input" class="btn">{{ page.import_data }}</label>
      <button id="logout-btn" class="btn btn-danger">{{ page.logout }}</button>
      {% include language_toggle.liquid %}
    </div>
  </div>
</div>
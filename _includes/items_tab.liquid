<div class="tab-pane fade {%- if include.tab_index == 0 %} show active{% endif %}" id="{{ include.collection }}-tab-pane" role="tabpanel" aria-labelledby="{{ include.collection }}-tab" tabindex="{{ include.tab_index }}">
  {% comment %} <div class="input-group my-3" id="{{ include.collection }}-search-container">
    <input type="search" class="form-control" id="{{ include.collection }}-search-input" placeholder="{{ page.search }} {{ include.localized_collection | downcase }}..." aria-label="{{ page.search }} {{ include.localized_collection | downcase }}">
  </div>

  <!-- Sorting and Filtering Controls -->
  <div class="d-flex flex-wrap gap-2 mb-3 sorting-filtering-controls">
    <!-- Sorting Dropdown -->
    <div class="dropdown">
      <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" id="{{ include.collection }}-sort-dropdown" data-bs-toggle="dropdown" aria-expanded="false">
        <i class="fa-solid fa-sort"></i> {{ page.sort_by }}
      </button>
      <ul class="dropdown-menu" aria-labelledby="{{ include.collection }}-sort-dropdown">
        <li><a class="dropdown-item sort-option" href="#" data-sort="date" data-category="{{ include.collection }}">
          <i class="fa-solid fa-calendar"></i> {{ page.sort_by_date }}
        </a></li>
        <li><a class="dropdown-item sort-option" href="#" data-sort="name" data-category="{{ include.collection }}">
          <i class="fa-solid fa-font"></i> {{ page.sort_by_name }}
        </a></li>
        <li><a class="dropdown-item sort-option" href="#" data-sort="quantity" data-category="{{ include.collection }}">
          <i class="fa-solid fa-hashtag"></i> {{ page.sort_by_quantity }}
        </a></li>
      </ul>
    </div>

    <!-- Filter Buttons -->
    <div class="btn-group filter-buttons" role="group" aria-label="Filter options">
      <input type="radio" class="btn-check filter-option" name="{{ include.collection }}-filter" id="{{ include.collection }}-filter-all" data-filter="all" data-category="{{ include.collection }}" checked>
      <label class="btn btn-outline-primary btn-sm" for="{{ include.collection }}-filter-all">{{ page.all_items }}</label>

      <input type="radio" class="btn-check filter-option" name="{{ include.collection }}-filter" id="{{ include.collection }}-filter-opened" data-filter="opened" data-category="{{ include.collection }}">
      <label class="btn btn-outline-primary btn-sm" for="{{ include.collection }}-filter-opened">{{ page.opened_items }}</label>

      <input type="radio" class="btn-check filter-option" name="{{ include.collection }}-filter" id="{{ include.collection }}-filter-unopened" data-filter="unopened" data-category="{{ include.collection }}">
      <label class="btn btn-outline-primary btn-sm" for="{{ include.collection }}-filter-unopened">{{ page.unopened_items }}</label>
    </div>
  </div>
  <ul class="list-group list-group-flush list-unstyled mt-3" id="{{ include.collection }}-list"></ul>
  <!-- Floating add item button -->
  <div class="fixed-action-btn" style="height: 80px;">
    <button class="btn btn-floating text-white btn-lg" aria-label="{{ page.add_item }}" style="background-color: #f44336;" data-bs-toggle="modal" data-bs-target="#add-item-modal">
      <i class="fa-solid fa-plus"></i>
    </button>
  </div> {% endcomment %}
</div>
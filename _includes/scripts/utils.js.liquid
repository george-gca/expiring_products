// Application-wide constants
const APP_CONSTANTS = {
  SORT_DIRECTIONS: {
    ASCENDING: 'asc',
    DESCENDING: 'desc'
  },
  SORT_CRITERIA: {
    DATE: 'date',
    NAME: 'name',
    QUANTITY: 'quantity'
  },
  FILTER_OPTIONS: {
    ALL: 'all',
    OPENED: 'opened',
    UNOPENED: 'unopened'
  },
  CSS_CLASSES: {
    LIST_ITEM_DANGER: 'list-group-item-danger',
    LIST_ITEM_WARNING: 'list-group-item-warning'
  }
};

// Constants for time calculations
const MILLISECONDS_PER_SECOND = 1000;
const SECONDS_PER_MINUTE = 60;
const MINUTES_PER_HOUR = 60;
const EXPIRY_WARNING_DAYS = 3;

// ========================================
// SORTING AND FILTERING UTILITIES
// ========================================

/**
 * Sort items by expiration date, opened status, and quantity (legacy function)
 * @param {Object} items - Object containing items to sort
 * @param {Array} sortedItems - Array to populate with sorted items
 */
function sortItems(items, sortedItems) {
  sortedItems.length = 0;
  sortedItems.push(...Object.values(items));

  // Sort by: 1) expiring date (earliest first), 2) opened status (opened first), 3) quantity (highest first)
  sortedItems.sort((a, b) =>
    a.expiring_date - b.expiring_date ||
    b.opened - a.opened ||
    b.quantity - a.quantity
  );
}

/**
 * Enhanced sort items function with configurable sort criteria and direction
 * @param {Object} items - Object containing items to sort
 * @param {Array} sortedItems - Array to populate with sorted items
 * @param {string} sortBy - Sort criteria: 'date', 'name', or 'quantity'
 * @param {string} direction - Sort direction: 'asc' or 'desc'
 */
function sortItemsBy(items, sortedItems, sortBy = 'date', direction = 'asc') {
  sortedItems.length = 0;
  sortedItems.push(...Object.values(items));

  const multiplier = direction === 'desc' ? -1 : 1;

  switch (sortBy) {
    case 'name':
      sortedItems.sort((a, b) => {
        const nameComparison = a.name.toLowerCase().localeCompare(b.name.toLowerCase()) * multiplier;
        return nameComparison !== 0 ? nameComparison :
               (a.expiring_date - b.expiring_date || b.opened - a.opened);
      });
      break;

    case 'quantity':
      sortedItems.sort((a, b) => {
        const quantityComparison = (b.quantity - a.quantity) * multiplier;
        return quantityComparison !== 0 ? quantityComparison :
               (a.expiring_date - b.expiring_date || b.opened - a.opened);
      });
      break;

    case 'date':
    default:
      // For date sorting, consider the multiplier
      sortedItems.sort((a, b) => {
        const dateComparison = (a.expiring_date - b.expiring_date) * multiplier;
        return dateComparison !== 0 ? dateComparison :
               (b.opened - a.opened || b.quantity - a.quantity);
      });
      break;
  }
}

/**
 * Sort an array of items by criteria and direction (array-based variant of sortItemsBy)
 * @param {Array} arr - Array of items to sort
 * @param {string} sortBy - Sort criteria: 'date', 'name', or 'quantity'
 * @param {string} direction - Sort direction: 'asc' or 'desc'
 * @returns {Array} New sorted array
 */
function sortArrayBy(arr, sortBy = 'date', direction = 'asc') {
  const sorted = [...arr];
  const multiplier = direction === 'desc' ? -1 : 1;

  switch (sortBy) {
    case 'name':
      sorted.sort((a, b) => {
        const nameComparison = a.name.toLowerCase().localeCompare(b.name.toLowerCase()) * multiplier;
        return nameComparison !== 0 ? nameComparison :
               (a.expiring_date - b.expiring_date || b.opened - a.opened);
      });
      break;

    case 'quantity':
      sorted.sort((a, b) => {
        const quantityComparison = (b.quantity - a.quantity) * multiplier;
        return quantityComparison !== 0 ? quantityComparison :
               (a.expiring_date - b.expiring_date || b.opened - a.opened);
      });
      break;

    case 'date':
    default:
      sorted.sort((a, b) => {
        const dateComparison = (a.expiring_date - b.expiring_date) * multiplier;
        return dateComparison !== 0 ? dateComparison :
               (b.opened - a.opened || b.quantity - a.quantity);
      });
      break;
  }

  return sorted;
}

/**
 * Filter items based on opened status
 * @param {Array} items - Array of items to filter
 * @param {string} filterBy - Filter criteria: 'all', 'opened', or 'unopened'
 * @returns {Array} Filtered array of items
 */
function filterItems(items, filterBy = 'all') {
  switch (filterBy) {
    case 'opened':
      return items.filter(item => item.opened);
    case 'unopened':
      return items.filter(item => !item.opened);
    case 'all':
    default:
      return items;
  }
}

/**
 * Filter items by expiry date distance
 * @param {Array} items - Array of items to filter
 * @param {number} monthsThreshold - Number of months threshold
 * @param {boolean} hideDistant - Whether to hide distant items
 * @param {boolean} showHidden - Whether to show hidden items (overrides hiding)
 * @returns {Array} Filtered array of items
 */
function filterItemsByExpiryDistance(items, monthsThreshold = 3, hideDistant = true, showHidden = false) {
  if (!hideDistant || showHidden) {
    return items;
  }

  const thresholdDate = DateTime.now().plus({ months: monthsThreshold });

  return items.filter(item => item.expiring_date <= thresholdDate);
}

/**
 * Count items that would be hidden by expiry distance filter
 * @param {Array} items - Array of items to count
 * @param {number} monthsThreshold - Number of months threshold
 * @returns {number} Number of items that would be hidden
 */
function countDistantItems(items, monthsThreshold = 3) {
  const thresholdDate = DateTime.now().plus({ months: monthsThreshold });

  return items.filter(item => item.expiring_date > thresholdDate).length;
}

/**
 * Global storage for current sorting and filtering preferences per category
 */
window.sortingPreferences = window.sortingPreferences || {};
window.sortingDirections = window.sortingDirections || {};
window.filteringPreferences = window.filteringPreferences || {};

// ========================================
// CONFIGURATION
// ========================================

// Error handling utilities
const ErrorHandler = {
  /**
   * Display user-friendly error message
   * @param {string} message - User-friendly error message
   * @param {Error} error - The actual error object (for logging)
   */
  showError(message, error = null) {
    if (error) {
      console.error('Error details:', error);
    }
    // TODO: Replace with proper notification system (toast, etc.)
    alert(message);
  },

  /**
   * Handle database operation errors
   * @param {string} operation - The operation that failed
   * @param {Error} error - The error object
   */
  handleDatabaseError(operation, error) {
    console.error(`Database ${operation} failed:`, error);

    // Provide user-friendly messages based on error type
    let userMessage = `Failed to ${operation}. `;

    if (error.code === 'permission-denied') {
      userMessage += 'You do not have permission to perform this action.';
    } else if (error.code === 'unavailable') {
      userMessage += 'Service is currently unavailable. Please try again later.';
    } else if (error.code === 'unauthenticated') {
      userMessage += 'Please log in again to continue.';
    } else {
      userMessage += 'Please try again or contact support if the problem persists.';
    }

    this.showError(userMessage, error);
  }
};

// ========================================
// SCHEDULED TASKS AND EXPIRY CHECKING
// ========================================

/**
 * Execute a callback function every day at midnight
 * @param {Function} callback - The function to execute daily
 */
const everyDay = (callback) => {
  const now = new Date();
  const millisecondsUntilMidnight =
    HOURS_PER_DAY * MINUTES_PER_HOUR * SECONDS_PER_MINUTE * MILLISECONDS_PER_SECOND -
    now.getHours() * MINUTES_PER_HOUR * SECONDS_PER_MINUTE * MILLISECONDS_PER_SECOND -
    now.getMinutes() * SECONDS_PER_MINUTE * MILLISECONDS_PER_SECOND -
    now.getSeconds() * MILLISECONDS_PER_SECOND -
    now.getMilliseconds();

  setTimeout(async () => {
    try {
      await callback();
      everyDay(callback); // Schedule next execution
    } catch (error) {
      console.error('Daily callback execution failed:', error);
      // Retry after 1 hour if callback fails
      setTimeout(() => everyDay(callback), MINUTES_PER_HOUR * SECONDS_PER_MINUTE * MILLISECONDS_PER_SECOND);
    }
  }, millisecondsUntilMidnight);
};

/**
 * Check and update visual indicators for item expiration status
 * @param {Object} item - The item to check
 * @param {number} idx - The index of the item in the list
 * @returns {boolean} True if processing should continue, false to stop
 */
function checkExpiryDateInList(item, itemIndex) {
  const currentDateTime = DateTime.now();
  const itemExpirationDate = DateTime.fromISO(item.expiring_date);
  const listItemElement = document.getElementById(this.listId).children[itemIndex].children[0];

  if (itemExpirationDate < currentDateTime) {
    // Item has expired - mark as danger
    if (listItemElement.classList.contains(APP_CONSTANTS.CSS_CLASSES.LIST_ITEM_DANGER)) {
      return false; // Already marked, no change needed
    }

    listItemElement.classList.remove(APP_CONSTANTS.CSS_CLASSES.LIST_ITEM_WARNING);
    listItemElement.classList.add(APP_CONSTANTS.CSS_CLASSES.LIST_ITEM_DANGER);

  } else {
    const daysUntilExpiry = Interval.fromDateTimes(currentDateTime, itemExpirationDate).length('days');

    if (daysUntilExpiry <= EXPIRY_WARNING_DAYS) {
      // Item expires within warning threshold - mark as warning
      if (listItemElement.classList.contains(APP_CONSTANTS.CSS_CLASSES.LIST_ITEM_WARNING)) {
        return false; // Already marked, no change needed
      }

      listItemElement.classList.add(APP_CONSTANTS.CSS_CLASSES.LIST_ITEM_WARNING);

    } else {
      // Item is fine - since items are sorted by expiry date, we can stop checking
      return true;
    }
  }

  return false;
}

/**
 * Check expiry dates for all items across all categories
 * Updates UI indicators for expired and soon-to-expire items
 */
function checkExpiryDates() {
  if (!window.userCategories || !window.sortedItemsByCategory) {
    console.warn('Categories or sorted items not available for expiry checking');
    return;
  }

  window.userCategories.forEach(category => {
    const categorySortedItems = window.sortedItemsByCategory[category.key];

    if (categorySortedItems && categorySortedItems.length > 0) {
      // Use 'some' to allow early termination when items are no longer near expiry
      const categoryListContext = { listId: `${category.key}-list` };
      categorySortedItems.some(checkExpiryDateInList, categoryListContext);
    }
  });
}

everyDay(checkExpiryDates);

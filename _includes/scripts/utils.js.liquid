/**
 * Expiry distance filter settings management
 */
const ExpiryFilterSettings = {
  /**
   * Get the current expiry filter settings
   * @returns {Object} Settings object with enabled state and months threshold
   */
  getSettings() {
    const enabled = localStorage.getItem('hideDistantItems') !== 'false'; // Default to true
    const monthsThreshold = parseInt(localStorage.getItem('expiryThresholdMonths')) || 3;
    return { enabled, monthsThreshold };
  },

  /**
   * Save expiry filter settings
   * @param {boolean} enabled - Whether to hide distant items
   * @param {number} monthsThreshold - Number of months threshold
   */
  saveSettings(enabled, monthsThreshold) {
    localStorage.setItem('hideDistantItems', enabled.toString());
    localStorage.setItem('expiryThresholdMonths', monthsThreshold.toString());
  },

  /**
   * Initialize settings controls with saved values
   */
  initializeControls() {
    const settings = this.getSettings();

    const switchElement = document.getElementById('hide-distant-items-switch');
    const monthsElement = document.getElementById('expiry-threshold-months');

    if (switchElement) {
      switchElement.checked = settings.enabled;
    }

    if (monthsElement) {
      monthsElement.value = settings.monthsThreshold;
    }

    // Add event listeners
    if (switchElement) {
      switchElement.addEventListener('change', () => {
        this.saveSettings(switchElement.checked, parseInt(monthsElement?.value || 3));
        if (typeof updateDisplay === 'function') {
          updateDisplay();
        }
      });
    }

    if (monthsElement) {
      monthsElement.addEventListener('input', () => {
        this.saveSettings(switchElement?.checked || true, parseInt(monthsElement.value));
        if (typeof updateDisplay === 'function') {
          updateDisplay();
        }
      });
    }
  }
};


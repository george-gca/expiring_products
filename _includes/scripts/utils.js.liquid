/**
 * Sort items by expiration date, opened status, and quantity (legacy function)
 * @param {Object} items - Object containing items to sort
 * @param {Array} sortedItems - Array to populate with sorted items
 */
function sortItems(items, sortedItems) {
  sortedItems.length = 0;
  sortedItems.push(...Object.values(items));

  // Sort by: 1) expiring date (earliest first), 2) opened status (opened first), 3) quantity (highest first)
  sortedItems.sort((a, b) =>
    a.expiring_date - b.expiring_date ||
    b.opened - a.opened ||
    b.quantity - a.quantity
  );
}

/**
 * Enhanced sort items function with configurable sort criteria
 * @param {Object} items - Object containing items to sort
 * @param {Array} sortedItems - Array to populate with sorted items
 * @param {string} sortBy - Sort criteria: 'date', 'name', or 'quantity'
 */
function sortItemsBy(items, sortedItems, sortBy = 'date') {
  sortedItems.length = 0;
  sortedItems.push(...Object.values(items));

  switch (sortBy) {
    case 'name':
      sortedItems.sort((a, b) => {
        const nameComparison = a.name.toLowerCase().localeCompare(b.name.toLowerCase());
        return nameComparison !== 0 ? nameComparison :
               (a.expiring_date - b.expiring_date || b.opened - a.opened);
      });
      break;

    case 'quantity':
      sortedItems.sort((a, b) => {
        const quantityComparison = b.quantity - a.quantity;
        return quantityComparison !== 0 ? quantityComparison :
               (a.expiring_date - b.expiring_date || b.opened - a.opened);
      });
      break;

    case 'date':
    default:
      // Default sorting: expiration date first, then opened status, then quantity
      sortedItems.sort((a, b) =>
        a.expiring_date - b.expiring_date ||
        b.opened - a.opened ||
        b.quantity - a.quantity
      );
      break;
  }
}

/**
 * Filter items based on opened status
 * @param {Array} items - Array of items to filter
 * @param {string} filterBy - Filter criteria: 'all', 'opened', or 'unopened'
 * @returns {Array} Filtered array of items
 */
function filterItems(items, filterBy = 'all') {
  switch (filterBy) {
    case 'opened':
      return items.filter(item => item.opened);
    case 'unopened':
      return items.filter(item => !item.opened);
    case 'all':
    default:
      return items;
  }
}

/**
 * Global storage for current sorting and filtering preferences per category
 */
window.sortingPreferences = window.sortingPreferences || {};
window.filteringPreferences = window.filteringPreferences || {};

// Register service worker for offline functionality
if ('serviceWorker' in navigator) {
  navigator.serviceWorker.register('/assets/js/sw.js');
}

/**
 * Execute a callback function every day at the same time
 * @param {Function} callback - The function to execute daily
 */
const everyDay = (callback) => {
  const now = new Date();
  const millisecondsUntilMidnight =
    24 * 3600000 -
    now.getHours() * 3600000 -
    now.getMinutes() * 60000 -
    now.getSeconds() * 1000 -
    now.getMilliseconds();

  setTimeout(async () => {
    await callback();
    everyDay(callback); // Schedule next execution
  }, millisecondsUntilMidnight);
};

/**
 * Check and update visual indicators for item expiration status
 * @param {Object} item - The item to check
 * @param {number} idx - The index of the item in the list
 * @returns {boolean} True if processing should continue, false to stop
 */
function checkExpiryDateInList(item, idx) {
  const now = DateTime.now();
  const expirationDate = DateTime.fromISO(item.expiring_date);
  const listItem = document.getElementById(this.listId).children[idx].children[0];

  if (expirationDate < now) {
    // Item has expired - mark as danger
    if (listItem.classList.contains('list-group-item-danger')) {
      return false; // Already marked, no change needed
    }

    listItem.classList.remove('list-group-item-warning');
    listItem.classList.add('list-group-item-danger');

  } else {
    const daysUntilExpiry = Interval.fromDateTimes(now, expirationDate).length('days');

    if (daysUntilExpiry <= 3) {
      // Item expires within 3 days - mark as warning
      if (listItem.classList.contains('list-group-item-warning')) {
        return false; // Already marked, no change needed
      }

      listItem.classList.add('list-group-item-warning');

    } else {
      // Item is fine - since items are sorted by expiry date, we can stop checking
      return true;
    }
  }

  return false;
}

/**
 * Check expiry dates for all items across all categories
 * Updates UI indicators for expired and soon-to-expire items
 */
function checkExpiryDates() {
  if (!window.userCategories || !window.sortedItemsByCategory) {
    return;
  }

  window.userCategories.forEach(category => {
    const sortedItems = window.sortedItemsByCategory[category.key];

    if (sortedItems && sortedItems.length > 0) {
      // Use 'some' to allow early termination when items are no longer near expiry
      sortedItems.some(checkExpiryDateInList, { listId: `${category.key}-list` });
    }
  });
}

everyDay(checkExpiryDates);

function setupCategoriesListener() {
  if (!currentUser) return;

  return db.collection('users').doc(currentUser.uid).collection('categories')
    .orderBy('order', 'asc')
    .onSnapshot(querySnapshot => {
      window.userCategories = [];

      querySnapshot.forEach(doc => {
        window.userCategories.push({
          id: doc.id,
          ...doc.data()
        });
      });

      // If no categories exist, create default ones
      if (window.userCategories.length === 0) {
        initializeDefaultCategories();
      } else {
        updateCategoryTabs();
        setupCategoryListeners();
      }
    }, error => {
      console.error("Categories listener error: ", error);
    });
}

async function initializeDefaultCategories() {
  const defaultCategories = [
    { name: '{{ page.foods }}', key: 'foods', order: 0 },
    { name: '{{ page.utilities }}', key: 'utilities', order: 1 },
    { name: '{{ page.medicines }}', key: 'medicines', order: 2 }
  ];

  try {
    const batch = db.batch();
    defaultCategories.forEach(category => {
      const docRef = db.collection('users').doc(currentUser.uid).collection('categories').doc();
      batch.set(docRef, category);
    });
    await batch.commit();
    console.log("Default categories created");
  } catch (error) {
    console.error("Error creating default categories: ", error);
  }
}

async function migrateExistingData() {
  if (!currentUser) return;

  try {
    // Check if migration has already been done by looking for categories
    const categoriesSnapshot = await db.collection('users').doc(currentUser.uid).collection('categories').get();
    if (!categoriesSnapshot.empty) {
      console.log("Categories already exist, skipping migration");
      return;
    }

    // Check if old data exists
    const oldDataExists = await checkOldDataExists();
    if (!oldDataExists) {
      console.log("No old data to migrate");
      return;
    }

    console.log("Starting data migration...");

    // Create default categories first
    await initializeDefaultCategories();

    // Wait a bit for categories to be created
    await new Promise(resolve => setTimeout(resolve, 1000));

    // Migrate items from old collections
    const migrations = [
      { oldCollection: 'foods', category: 'foods' },
      { oldCollection: 'utilities', category: 'utilities' },
      { oldCollection: 'medicines', category: 'medicines' }
    ];

    const batch = db.batch();
    let itemCount = 0;

    for (const migration of migrations) {
      const oldSnapshot = await db.collection('households').doc(currentUser.uid).collection(migration.oldCollection).get();

      oldSnapshot.forEach(doc => {
        const data = doc.data();
        const newItemRef = db.collection('users').doc(currentUser.uid).collection('items').doc();
        batch.set(newItemRef, {
          ...data,
          category: migration.category
        });
        itemCount++;
      });
    }

    if (itemCount > 0) {
      await batch.commit();
      console.log(`Migrated ${itemCount} items to new structure`);
    }

    // Migrate history data
    await migrateHistoryData();

  } catch (error) {
    console.error("Error during migration: ", error);
  }
}

async function checkOldDataExists() {
  try {
    const collections = ['foods', 'utilities', 'medicines'];
    for (const collection of collections) {
      const snapshot = await db.collection('households').doc(currentUser.uid).collection(collection).limit(1).get();
      if (!snapshot.empty) {
        return true;
      }
    }
    return false;
  } catch (error) {
    console.error("Error checking old data: ", error);
    return false;
  }
}

async function migrateHistoryData() {
  try {
    const historyCollections = [
      { old: 'foods_history', category: 'foods' },
      { old: 'utilities_history', category: 'utilities' },
      { old: 'medicines_history', category: 'medicines' }
    ];

    const batch = db.batch();
    let historyCount = 0;

    for (const historyCollection of historyCollections) {
      const oldHistorySnapshot = await db.collection('households').doc(currentUser.uid).collection(historyCollection.old).get();

      oldHistorySnapshot.forEach(doc => {
        const data = doc.data();
        const newHistoryRef = db.collection('users').doc(currentUser.uid).collection('item_history').doc();
        batch.set(newHistoryRef, {
          ...data,
          category: historyCollection.category
        });
        historyCount++;
      });
    }

    if (historyCount > 0) {
      await batch.commit();
      console.log(`Migrated ${historyCount} history items to new structure`);
    }
  } catch (error) {
    console.error("Error migrating history data: ", error);
  }
}

/**
 * Add or update item history for autocomplete suggestions
 * @param {string} name - The item name
 * @param {string} duration - How long the item typically lasts
 * @param {boolean} recurring - Whether this is a recurring purchase
 * @param {string} category - The category key
 */
function addHistoryData(name, duration, recurring, category) {
  if (!currentUser || !name) return;

  // Use composite ID to prevent duplicate history entries per category
  const historyDocId = `${category}_${name}`;

  db.collection('users').doc(currentUser.uid).collection('item_history').doc(historyDocId).set({
    name: name,
    category: category,
    duration: duration || "",
    recurring: recurring || false
  }, { merge: true })
  .catch(error => {
    console.error("Error saving item history: ", error);
  });
}

/**
 * Add a new item to the database
 * @param {Object} newItem - The item data to add
 * @returns {Promise} Promise that resolves when item is added
 */
function addData(newItem) {
  if (!currentUser) return Promise.reject("User not authenticated");

  return db.collection('users').doc(currentUser.uid).collection('items').add(newItem)
    .catch(error => {
      console.error("Error adding item: ", error);
      throw error;
    });
}

/**
 * Setup real-time listener for items in a specific category
 * @param {string} category - The category key to listen for
 * @returns {Function} Unsubscribe function for the listener
 */
function setupRealtimeListener(category) {
  if (!currentUser) return;

  const fuseOptions = {
    keys: ['name'],
    threshold: 0.4,
    isCaseSensitive: false,
  };

  return db.collection('users').doc(currentUser.uid).collection('items')
    .where('category', '==', category)
    .orderBy("expiring_date", "asc")
    .onSnapshot(querySnapshot => {
      const categoryItems = {};

      // Process each item document
      querySnapshot.forEach(doc => {
        const data = doc.data();
        categoryItems[doc.id] = {
          id: doc.id,
          ...data,
          expiring_date: DateTime.fromISO(data.expiring_date)
        };
      });

      // Initialize global data structures if needed
      initializeGlobalDataStructures();

      // Update category-specific data
      updateCategoryData(category, categoryItems, fuseOptions);

      // Refresh UI display
      updateDisplay();
    }, error => {
      console.error("Firestore listener error: ", error);
    });
}

/**
 * Initialize global data structures for category management
 */
function initializeGlobalDataStructures() {
  if (!window.itemsByCategory) window.itemsByCategory = {};
  if (!window.sortedItemsByCategory) window.sortedItemsByCategory = {};
  if (!window.fuseByCategory) window.fuseByCategory = {};
}

/**
 * Update data structures for a specific category
 * @param {string} category - The category key
 * @param {Object} categoryItems - Items for this category
 * @param {Object} fuseOptions - Fuse.js configuration options
 */
function updateCategoryData(category, categoryItems, fuseOptions) {
  window.itemsByCategory[category] = categoryItems;

  // Sort items for this category
  window.sortedItemsByCategory[category] = [];
  sortItems(categoryItems, window.sortedItemsByCategory[category]);

  // Create or update the Fuse.js search index for this category
  window.fuseByCategory[category] = new Fuse(window.sortedItemsByCategory[category], fuseOptions);
}

/**
 * Update an existing item in the database
 * @param {Object} editedItem - The item data to update (must include id)
 */
function editData(editedItem) {
  if (!currentUser) return;

  const dataToUpdate = { ...editedItem };
  delete dataToUpdate.id; // Remove ID as it's not part of the update payload

  db.collection('users').doc(currentUser.uid).collection('items').doc(editedItem.id).update(dataToUpdate)
    .catch(error => {
      console.error("Error updating item: ", error);
    });
}

/**
 * Delete an item from the database
 * @param {string} id - The item ID to delete
 */
function deleteData(id) {
  if (!currentUser) return;

  db.collection('users').doc(currentUser.uid).collection('items').doc(id).delete()
    .catch(error => console.error("Error deleting item: ", error));
}

/**
 * Add a new category to the database
 * @param {Object} categoryData - The category data to add
 * @returns {Promise<string>} Promise that resolves with the new category ID
 */
function addCategory(categoryData) {
  if (!currentUser) return Promise.reject("User not authenticated");

  return db.collection('users').doc(currentUser.uid).collection('categories').add(categoryData)
    .then(docRef => {
      console.log("Category added with ID: ", docRef.id);
      return docRef.id;
    })
    .catch(error => {
      console.error("Error adding category: ", error);
      throw error;
    });
}

/**
 * Update an existing category in the database
 * @param {string} categoryId - The category ID to update
 * @param {Object} categoryData - The updated category data
 * @returns {Promise} Promise that resolves when update is complete
 */
function updateCategory(categoryId, categoryData) {
  if (!currentUser) return Promise.reject("User not authenticated");

  return db.collection('users').doc(currentUser.uid).collection('categories').doc(categoryId).update(categoryData)
    .then(() => {
      console.log("Category updated successfully");
    })
    .catch(error => {
      console.error("Error updating category: ", error);
      throw error;
    });
}

/**
 * Delete a category from the database
 * @param {string} categoryId - The category ID to delete
 * @returns {Promise} Promise that resolves when deletion is complete
 */
function deleteCategory(categoryId) {
  if (!currentUser) return Promise.reject("User not authenticated");

  return db.collection('users').doc(currentUser.uid).collection('categories').doc(categoryId).delete()
    .then(() => {
      console.log("Category deleted successfully");
    })
    .catch(error => {
      console.error("Error deleting category: ", error);
      throw error;
    });
}

/**
 * Setup real-time listener for user categories
 * Updates the UI whenever categories are added, modified, or deleted
 * @returns {Function} Unsubscribe function for the listener
 */
function setupCategoriesListener() {
  if (!currentUser) return;

  return db.collection('users').doc(currentUser.uid).collection('categories')
    .orderBy('order', 'asc')
    .onSnapshot(querySnapshot => {
      window.userCategories = [];

      querySnapshot.forEach(doc => {
        window.userCategories.push({
          id: doc.id,
          ...doc.data()
        });
      });

      // Update UI with current categories
      updateCategoryTabs();
      setupCategoryListeners();
    }, error => {
      console.error("Categories listener error: ", error);
    });
}

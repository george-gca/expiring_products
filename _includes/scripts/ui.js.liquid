/**
 * Add Item Modal Event Handler
 * Prepares the modal when shown, including form reset, date setup, and category selection
 */
document.getElementById('add-item-modal').addEventListener('show.bs.modal', function (event) {
  const button = event.relatedTarget;

  // Only reset form if modal was opened by a data-bs-toggle button
  // This prevents resetting when opened programmatically from shopping list
  if (button) {
    resetAddItemForm();
  }

  setupExpirationDate();
  clearDatalistOptions();
  updateCategoryDropdown();

  const currentCategory = getCurrentActiveCategory();
  if (currentCategory) {
    setSelectedCategory(currentCategory);
    loadCategoryHistory(currentCategory);
  }
});

/**
 * Reset the add item form to its default state
 */
function resetAddItemForm() {
  document.getElementById('new-item-name').value = "";
  document.getElementById('new-item-quantity').value = "";
  document.getElementById('new-item-duration').value = "";
  document.getElementById('add-item-modal-title').textContent = '{{ page.add_item }}';
}

/**
 * Setup expiration date input with current date as default and minimum
 */
function setupExpirationDate() {
  const expiringDateElement = document.getElementById('new-item-expiring-date');
  const currentDate = new Date();
  expiringDateElement.min = currentDate.toISOString().split('T')[0];
  expiringDateElement.valueAsDate = currentDate;
}

/**
 * Clear all datalist options for autocomplete
 */
function clearDatalistOptions() {
  const datalistOptions = document.getElementById('datalistOptions');
  while (datalistOptions.firstChild) {
    datalistOptions.removeChild(datalistOptions.firstChild);
  }
}

/**
 * Get the currently active category from the tab navigation
 * @returns {string|null} The active category key or null if none found
 */
function getCurrentActiveCategory() {
  const activeTab = document.querySelector('.nav-link.active');
  return activeTab ? activeTab.getAttribute('data-category') : null;
}

/**
 * Set the selected category in the dropdown
 * @param {string} categoryKey - The category key to select
 */
function setSelectedCategory(categoryKey) {
  const categorySelect = document.getElementById('new-item-category');
  if (categorySelect) {
    categorySelect.value = categoryKey;
  }
}

/**
 * Load historical items for autocomplete suggestions
 * @param {string} categoryKey - The category to load history for
 */
function loadCategoryHistory(categoryKey) {
  if (!currentUser) return;

  db.collection('users').doc(currentUser.uid).collection('item_history')
    .where('category', '==', categoryKey)
    .get()
    .then(querySnapshot => {
      const datalistOptions = document.getElementById('datalistOptions');
      querySnapshot.forEach(doc => {
        const item = doc.data();
        const option = document.createElement("option");
        option.value = item.name;
        option.setAttribute("data-duration", item.duration);
        option.setAttribute("data-recurring", item.recurring || false);
        datalistOptions.appendChild(option);
      });
    })
    .catch(error => {
      console.error("Error loading category history: ", error);
    });
}

document.getElementById('add-item-modal').querySelector('form').addEventListener("submit", addItemFromForm);

// Clean up shopping item reference when modal is hidden (in case user cancels)
document.getElementById('add-item-modal').addEventListener('hidden.bs.modal', function () {
  // Clear the shopping item reference if modal was closed without purchase
  if (window.currentShoppingItem) {
    window.currentShoppingItem = null;
  }
});

/**
 * Edit Item Modal Event Handler
 * Prepares the edit modal with item details and quantity controls
 */
document.getElementById('edit-item-modal').addEventListener('show.bs.modal', function (event) {
  const button = event.relatedTarget;
  const itemId = button.getAttribute('data-bs-id');
  const category = button.getAttribute('data-category');

  const item = findItem(category, itemId);
  if (!item) return;

  setupEditModalForm(itemId, category, item);
  setupQuantityControls(item.quantity);
});

/**
 * Find an item by category and ID
 * @param {string} category - The category key
 * @param {string} itemId - The item ID
 * @returns {Object|null} The item object or null if not found
 */
function findItem(category, itemId) {
  if (window.itemsByCategory && window.itemsByCategory[category]) {
    return window.itemsByCategory[category][itemId];
  }
  return null;
}

/**
 * Setup the edit modal form with item data
 * @param {string} itemId - The item ID
 * @param {string} category - The category key
 * @param {Object} item - The item data
 */
function setupEditModalForm(itemId, category, item) {
  const formElement = document.getElementById('edit-item-modal').querySelector('form');
  formElement.setAttribute("data-item-id", itemId);
  formElement.setAttribute("data-category", category);

  document.getElementById('edit-item-modal-title').textContent = '{{ page.edit }} ' + item.name;
}

/**
 * Setup quantity control inputs with dynamic max values
 * @param {number} totalQuantity - The total quantity of the item
 */
function setupQuantityControls(totalQuantity) {
  const openedInput = document.getElementById('opened-items');
  const consumedInput = document.getElementById('consumed-items');
  const discardedInput = document.getElementById('discarded-items');

  // Reset values and set initial max
  [openedInput, consumedInput, discardedInput].forEach(input => {
    input.value = 0;
    input.max = totalQuantity;
  });

  /**
   * Update maximum values based on current input values
   * Ensures total doesn't exceed available quantity
   */
  const updateMaxValues = () => {
    const openedVal = parseInt(openedInput.value) || 0;
    const consumedVal = parseInt(consumedInput.value) || 0;
    const discardedVal = parseInt(discardedInput.value) || 0;

    openedInput.max = totalQuantity - (consumedVal + discardedVal);
    consumedInput.max = totalQuantity - (openedVal + discardedVal);
    discardedInput.max = totalQuantity - (openedVal + consumedVal);
  };

  // Add event listeners for dynamic max value updates
  [openedInput, consumedInput, discardedInput].forEach(input => {
    input.addEventListener('input', updateMaxValues);
  });
}

document.getElementById('edit-item-modal').querySelector('form').addEventListener("submit", editItem);

/**
 * Auto-fill form fields when an item name is selected from history
 */
document.getElementById('new-item-name').addEventListener('change', function (event) {
  const selectedName = document.getElementById('new-item-name').value;
  const historyOptions = Array.from(document.getElementById('datalistOptions').children);

  const matchingOption = historyOptions.find(option => option.value === selectedName);
  if (matchingOption) {
    document.getElementById('new-item-duration').value = matchingOption.getAttribute("data-duration");
    document.getElementById('recurring-purchase-checkbox').checked = matchingOption.getAttribute("data-recurring") === "true";
  }
});

/**
 * Handle edit item form submission
 * Processes opened, consumed, and discarded quantities
 * @param {Event} e - The form submit event
 */
function editItem(e) {
  e.preventDefault();

  const category = e.target.getAttribute("data-category");
  const itemId = e.target.getAttribute("data-item-id");
  const item = findItem(category, itemId);

  if (!item) {
    console.error("Item not found for editing!");
    return;
  }

  const quantityInputs = getQuantityInputs();
  const totalActioned = quantityInputs.opened + quantityInputs.consumed + quantityInputs.discarded;

  if (!validateQuantities(totalActioned, item.quantity)) {
    return;
  }

  if (totalActioned === 0) {
    closeEditModal();
    return;
  }

  processItemActions(itemId, item, category, quantityInputs);
}

/**
 * Get quantity values from form inputs
 * @returns {Object} Object containing opened, consumed, and discarded quantities
 */
function getQuantityInputs() {
  return {
    opened: parseInt(document.getElementById('opened-items').value) || 0,
    consumed: parseInt(document.getElementById('consumed-items').value) || 0,
    discarded: parseInt(document.getElementById('discarded-items').value) || 0
  };
}

/**
 * Validate that quantities don't exceed available amount
 * @param {number} totalActioned - Sum of all actions
 * @param {number} availableQuantity - Available item quantity
 * @returns {boolean} True if valid, false otherwise
 */
function validateQuantities(totalActioned, availableQuantity) {
  if (totalActioned > availableQuantity) {
    alert('The sum of opened, consumed, and discarded items cannot be greater than the available quantity.');
    return false;
  }
  return true;
}

/**
 * Close the edit modal
 */
function closeEditModal() {
  const modalElement = document.getElementById('edit-item-modal');
  const modalInstance = bootstrap.Modal.getInstance(modalElement);
  modalInstance.hide();
}

/**
 * Process all item actions (open, consume, discard)
 * @param {string} itemId - The item ID
 * @param {Object} item - The item data
 * @param {string} category - The category key
 * @param {Object} quantities - Object with opened, consumed, discarded quantities
 */
function processItemActions(itemId, item, category, quantities) {
  const promises = [];

  if (quantities.opened > 0) {
    promises.push(openItem(itemId, quantities.opened, item, category));
  }
  if (quantities.consumed > 0) {
    promises.push(consumeItem(itemId, quantities.consumed, item, category));
  }
  if (quantities.discarded > 0) {
    promises.push(discardItem(itemId, quantities.discarded, item, category));
  }

  Promise.all(promises)
    .then(() => closeEditModal())
    .catch(error => {
      console.error("Failed to edit item:", error);
      alert('An error occurred while updating the item. Please try again.');
    });
}

function openItem(id, quantity, item, category) {
  const today = DateTime.now();
  const originalItemRef = db.collection('users').doc(currentUser.uid).collection('items').doc(id);

  // 1. Calculate the new expiration date
  let expiringDate;
  if (item.expiring_date < today) {
    expiringDate = item.expiring_date;
  } else {
    const newExpDate = today.plus({ days: item.duration }).endOf('day');
    expiringDate = newExpDate > item.expiring_date ? item.expiring_date : newExpDate;
  }
  const expiringDateISO = expiringDate.toISO();

  // 2. Query for a matching item *before* the transaction
  const query = db.collection('users').doc(currentUser.uid).collection('items')
    .where('name', '==', item.name)
    .where('category', '==', category)
    .where('opened', '==', true)
    .where('expiring_date', '==', expiringDateISO)
    .limit(1);

  return query.get().then(matchingItemsSnapshot => {
    // 3. Run the database updates inside a safe transaction
    return db.runTransaction(async (transaction) => {
      // --- ALL READS MUST HAPPEN FIRST ---
      const originalDoc = await transaction.get(originalItemRef);
      let existingOpenedItemDoc = null;
      if (!matchingItemsSnapshot.empty) {
        existingOpenedItemDoc = await transaction.get(matchingItemsSnapshot.docs[0].ref);
      }

      // --- ALL WRITES HAPPEN AFTER THE READS ---
      if (!originalDoc.exists) {
        throw "Original item document does not exist!";
      }
      const originalData = originalDoc.data();

      // Perform write on the original (unopened) item
      if (originalData.quantity > quantity) {
        transaction.update(originalItemRef, { quantity: originalData.quantity - quantity });
      } else {
        transaction.delete(originalItemRef);
      }

      // Perform write on the opened item (either update or create)
      if (existingOpenedItemDoc && existingOpenedItemDoc.exists) {
        // MATCH FOUND: Update the existing opened item
        const newQuantity = existingOpenedItemDoc.data().quantity + quantity;
        transaction.update(existingOpenedItemDoc.ref, { quantity: newQuantity });
      } else {
        // NO MATCH: Create a new opened item
        const newItemRef = db.collection('users').doc(currentUser.uid).collection('items').doc();
        transaction.set(newItemRef, {
          name: item.name,
          category: category,
          quantity: quantity,
          expiring_date: expiringDateISO,
          duration: item.duration,
          date_opened: today.toISO(),
          opened: true
        });
      }
    });
  }).then(() => {
    // Open item transaction successfully committed!
  }).catch((error) => {
    console.error("Open item transaction failed: ", error);
    throw error;
  });
}

function consumeItem(id, quantity, item, category) {
  const today = DateTime.now();
  const itemRef = db.collection('users').doc(currentUser.uid).collection('items').doc(id);
  const statsRef = db.collection('users').doc(currentUser.uid).collection('statistics').doc('stats');

  return db.runTransaction(async (transaction) => {
    const itemDoc = await transaction.get(itemRef);
    if (!itemDoc.exists) {
      throw "Item to consume does not exist!";
    }

    let statField;
    if (item.expiring_date < today) {
      statField = `${category}_consumed_expired_items`; // e.g., "foods_consumed_expired_items"
    } else {
      statField = `${category}_consumed_items`; // e.g., "medicines_consumed_items"
    }

    transaction.set(statsRef, {
      [statField]: firebase.firestore.FieldValue.increment(quantity)
    }, { merge: true });

    if (itemDoc.data().quantity > quantity) {
      const newQuantity = itemDoc.data().quantity - quantity;
      transaction.update(itemRef, { quantity: newQuantity });
    } else {
      transaction.delete(itemRef);
    }
  }).then(() => {
    // Consume item transaction successful.
  }).catch((error) => {
    console.error("Consume item transaction failed: ", error);
    throw error;
  });
}

function discardItem(id, quantity, item, category) {
  const today = DateTime.now();
  const itemRef = db.collection('users').doc(currentUser.uid).collection('items').doc(id);
  const statsRef = db.collection('users').doc(currentUser.uid).collection('statistics').doc('stats');

  return db.runTransaction(async (transaction) => {
    const itemDoc = await transaction.get(itemRef);
    if (!itemDoc.exists) {
      throw "Item to discard does not exist!";
    }

    const statsUpdate = {};
    if (item.expiring_date < today) {
      statsUpdate[`${category}_expired_discarded_items`] = firebase.firestore.FieldValue.increment(quantity);
      if (item.opened) {
        statsUpdate[`${category}_expired_opened_items`] = firebase.firestore.FieldValue.increment(quantity);
      }
    } else {
      statsUpdate[`${category}_discarded_items`] = firebase.firestore.FieldValue.increment(quantity);
    }

    transaction.set(statsRef, statsUpdate, { merge: true });

    if (itemDoc.data().quantity > quantity) {
      const newQuantity = itemDoc.data().quantity - quantity;
      transaction.update(itemRef, { quantity: newQuantity });
    } else {
      transaction.delete(itemRef);
    }
  }).then(() => {
    // Discard item transaction successful.
  }).catch((error) => {
    console.error("Discard item transaction failed: ", error);
    throw error;
  });
}

async function addItemFromForm(e) {
  // prevent default - we don't want the form to submit in the conventional way
  e.preventDefault();

  // Get the selected category from the dropdown or active tab
  let category;
  const categorySelect = document.getElementById('new-item-category');
  if (categorySelect) {
    category = categorySelect.value;
  } else {
    // Fallback to active tab if dropdown doesn't exist
    const activeTab = document.querySelector('.nav-link.active');
    category = activeTab ? activeTab.getAttribute('data-category') : null;
  }

  if (!category) {
    console.error("No category selected");
    return;
  }

  // grab the values entered into the form fields and store them in an object ready for being inserted into the DB
  const nameInput = document.getElementById("new-item-name");
  const quantityInput = document.getElementById("new-item-quantity");
  const expiringDateInput = document.getElementById("new-item-expiring-date");
  const durationInput = document.getElementById("new-item-duration");
  const recurring = document.getElementById('recurring-purchase-checkbox').checked;
  let expiringDate = DateTime.fromISO(expiringDateInput.value).endOf('day');

  let duration;
  if (durationInput.value === "") {
    // calculate duration based on the expiring date
    duration = Math.ceil(expiringDate.diff(DateTime.now(), 'days').days);
  } else {
    duration = durationInput.value;
  }

  addData({
    name: nameInput.value,
    category: category,
    quantity: quantityInput.value,
    expiring_date: expiringDate.toISO(),
    recurring: recurring,
    duration: duration,
    date_opened: null,
    opened: false
  }).then(async () => {
    // Item added successfully, clear form and close modal
    addHistoryData(nameInput.value, durationInput.value, recurring, category);

    nameInput.value = "";
    quantityInput.value = "";
    expiringDateInput.value = "";
    durationInput.value = "";
    document.getElementById('recurring-purchase-checkbox').checked = true;

    // Handle shopping mode item hiding after successful purchase
    if (window.currentShoppingItem) {
      // Add item name to temporarily hidden shopping items
      const hiddenItems = JSON.parse(localStorage.getItem('hiddenShoppingItems') || '[]');
      if (!hiddenItems.includes(window.currentShoppingItem.name)) {
        hiddenItems.push(window.currentShoppingItem.name);
        localStorage.setItem('hiddenShoppingItems', JSON.stringify(hiddenItems));
      }

      // Clear the reference
      window.currentShoppingItem = null;

      // Refresh the display to immediately reflect the hidden item
      if (typeof updateDisplay === 'function') {
        await updateDisplay();
      }
    }

    // Close the modal
    const modalElement = document.getElementById('add-item-modal');
    const modalInstance = bootstrap.Modal.getInstance(modalElement);
    modalInstance.hide();
  }).catch(error => {
    // Handle error - modal will stay open and browser will show validation errors
    console.error("Failed to add item:", error);
  });
}

// detect when export-products-input is clicked and export the products table
document.getElementById('export-products-input').addEventListener('click', function (e) {
  // Check if there are any items to export across all categories
  let hasItems = false;
  if (window.sortedItemsByCategory) {
    Object.values(window.sortedItemsByCategory).forEach(categoryItems => {
      if (categoryItems.length > 0) {
        hasItems = true;
      }
    });
  }

  if (!hasItems) {
    alert('{{ page.no_items_to_export }}');
    return;
  }

  exportToJson(db)
  .then(result => {
    const blob = new Blob([result], {type: 'application/json'});
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'expiring_products.json';
    a.click();
    URL.revokeObjectURL(url);
    a.remove();
  })
  .catch(error => {
    console.error('Something went wrong during export:', error);
  })
});

// detect when import-products-input is clicked and import the products table
document.getElementById('import-products-input').addEventListener('change', function (e) {
  const file = e.target.files[0];
  const reader = new FileReader();

  reader.onload = function (e) {
    const result = e.target.result;
    clearDatabase(db)
    .then(() => importFromJson(db, result))
    .then(() => {
      // Refresh all categories after import
      updateDisplay();
    })
    .catch(error => {
      console.error('Could not clear & import database:', error)
    })
  };

  reader.readAsText(file);
});

// Function to update category dropdown in modals
function updateCategoryDropdown() {
  const categorySelect = document.getElementById('new-item-category');
  if (!categorySelect || !window.userCategories) return;

  // Clear existing options
  categorySelect.innerHTML = '';

  // Add categories as options
  window.userCategories.forEach(category => {
    const option = document.createElement('option');
    option.value = category.key;
    option.textContent = category.name;
    categorySelect.appendChild(option);
  });
}

// Add new category
document.addEventListener('DOMContentLoaded', function() {
  const addCategoryBtn = document.getElementById('add-category-btn');
  const newCategoryNameInput = document.getElementById('new-category-name');
  const selectedEmojiSpan = document.getElementById('selected-emoji');

  // Setup emoji picker functionality
  // Wait for emoji-picker-element to be defined
  if (customElements.get('emoji-picker')) {
    setupEmojiPicker();
  } else {
    customElements.whenDefined('emoji-picker').then(setupEmojiPicker);
  }

  function setupEmojiPicker() {
    const emojiPicker = document.querySelector('emoji-picker');
    if (emojiPicker) {
      emojiPicker.addEventListener('emoji-click', function(event) {
        const selectedEmoji = event.detail.unicode;
        selectedEmojiSpan.textContent = selectedEmoji;

        // Close the dropdown
        const dropdown = bootstrap.Dropdown.getInstance(document.getElementById('emoji-picker-btn'));
        if (dropdown) {
          dropdown.hide();
        }
      });
    }
  }

  if (addCategoryBtn) {
    addCategoryBtn.addEventListener('click', async function() {
      const categoryName = newCategoryNameInput.value.trim();
      const categoryEmoji = selectedEmojiSpan.textContent || '📦';

      if (!categoryName) {
        alert('Please enter a category name');
        return;
      }

      // Generate a key from the name (lowercase, replace spaces with underscores)
      const categoryKey = categoryName.toLowerCase().replace(/\s+/g, '_').replace(/[^a-z0-9_]/g, '');

      // Check if key already exists
      const existingCategory = window.userCategories.find(cat => cat.key === categoryKey);
      if (existingCategory) {
        alert('A category with this name already exists');
        return;
      }

      try {
        const newOrder = window.userCategories.length;
        await addCategory({
          name: categoryName,
          key: categoryKey,
          emoji: categoryEmoji,
          order: newOrder
        });
        newCategoryNameInput.value = '';
        selectedEmojiSpan.textContent = '🛒'; // Reset to default
      } catch (error) {
        alert('Error adding category: ' + error.message);
      }
    });

    // Allow Enter key to add category from name input
    newCategoryNameInput.addEventListener('keypress', function(e) {
      if (e.key === 'Enter') {
        addCategoryBtn.click();
      }
    });
  }
});

// Edit category function
function editCategory(categoryId, currentName, currentKey) {
  const category = window.userCategories.find(cat => cat.id === categoryId);
  const currentEmoji = category?.emoji || '📦';

  const newName = prompt('Enter new category name:', currentName);
  if (!newName || newName.trim() === currentName) return;

  // Show available emojis for selection
  const availableEmojis = ['🛒', '🍎', '🥖', '🥛', '🧽', '🧴', '💊', '🧼', '🧻', '🪥', '🪒', '💄', '🧹', '🪣', '🔋', '💡', '🕯️', '📦', '🏠', '🧊', '❄️', '🌡️'];
  const emojiList = availableEmojis.join(' ');
  const newEmoji = prompt(`Choose an emoji for category (current: ${currentEmoji}):\n\nAvailable emojis:\n${emojiList}\n\nEnter your choice:`, currentEmoji);

  if (newEmoji === null) return; // User cancelled

  const updates = { name: newName.trim() };
  if (newEmoji !== currentEmoji) {
    updates.emoji = newEmoji.trim() || '📦';
  }

  updateCategory(categoryId, updates)
    .catch(error => {
      alert('Error updating category: ' + error.message);
    });
}

// Confirm delete category function
function confirmDeleteCategory(categoryId, categoryName) {
  if (confirm(`Are you sure you want to delete the category "${categoryName}"? This will also delete all items in this category.`)) {
    deleteCategory(categoryId)
      .then(async () => {
        // Delete all items in this category
        const categoryKey = window.userCategories.find(cat => cat.id === categoryId)?.key;
        if (categoryKey && window.itemsByCategory[categoryKey]) {
          const itemIds = Object.keys(window.itemsByCategory[categoryKey]);
          const deletePromises = itemIds.map(itemId => deleteData(itemId));
          await Promise.all(deletePromises);
        }
      })
      .catch(error => {
        alert('Error deleting category: ' + error.message);
      });
  }
}

// Make functions globally available
window.editCategory = editCategory;
window.confirmDeleteCategory = confirmDeleteCategory;

// Function to update the categories management list
function updateCategoriesList() {
  const categoriesList = document.getElementById('categories-list');
  if (!categoriesList || !window.userCategories) return;

  categoriesList.innerHTML = '';

  window.userCategories.forEach(category => {
    const categoryItem = document.createElement('div');
    categoryItem.className = 'card mb-2';
    categoryItem.innerHTML = `
      <div class="card-body d-flex justify-content-between align-items-center">
        <div>
          <strong>${category.name}</strong>
          <small class="text-muted d-block">Key: ${category.key}</small>
        </div>
        <div>
          <button class="btn btn-sm btn-outline-primary me-2" data-category-id="${category.id}" data-category-name="${category.name}" data-category-key="${category.key}" data-action="edit">
            <i class="fa-solid fa-edit"></i>
          </button>
          <button class="btn btn-sm btn-outline-danger" data-category-id="${category.id}" data-category-name="${category.name}" data-action="delete">
            <i class="fa-solid fa-trash"></i>
          </button>
        </div>
      </div>
    `;

    categoriesList.appendChild(categoryItem);

    // Add event listeners for the buttons
    const editBtn = categoryItem.querySelector('[data-action="edit"]');
    const deleteBtn = categoryItem.querySelector('[data-action="delete"]');

    editBtn.addEventListener('click', () => {
      editCategory(category.id, category.name, category.key);
    });

    deleteBtn.addEventListener('click', () => {
      confirmDeleteCategory(category.id, category.name);
    });
  });
}

<!-- Metadata, OpenGraph and Schema.org -->
{% include metadata.liquid %}

<!-- Favicon -->
<!-- Icons made by Freepik from www.flaticon.com -->
<link rel="shortcut icon" href="/assets/img/favicon_colored.png" type="image/x-icon" />

<!-- Progressive Web App Manifest -->
<link rel="manifest" href="expiring_products.webmanifest" />

<!-- Font Awesome -->
<link
  defer
  rel="stylesheet"
  href="{{ site.third_party_libraries.font-awesome.url.css }}"
  integrity="{{ site.third_party_libraries.font-awesome.integrity.css }}"
  crossorigin="anonymous"
>

<!-- Google Fonts -->
<link
  defer
  rel="stylesheet"
  type="text/css"
  href="{{ site.third_party_libraries.google_fonts.url.fonts }}"
>

<!-- Bootstrap -->
<link
  defer
  rel="stylesheet"
  href="{{ site.third_party_libraries.bootstrap.url.css }}"
  integrity="{{ site.third_party_libraries.bootstrap.integrity.css }}"
  crossorigin="anonymous"
>

<!-- MDB -->
<link
  defer
  rel="stylesheet"
  href="{{ site.third_party_libraries.mdb.url.css }}"
  integrity="{{ site.third_party_libraries.mdb.integrity.css }}"
  crossorigin="anonymous"
>

<link rel="stylesheet" href="{{ '/assets/css/main.css' | relative_url | bust_css_cache }}">
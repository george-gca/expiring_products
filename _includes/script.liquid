<script type="module">
  import { clearDatabase, exportToJson, importFromJson } from '/assets/js/backup-and-restore-data.mjs';

  // Luxon date library globals
  var DateTime = luxon.DateTime;
  var Interval = luxon.Interval;

  // Dynamic categories system globals
  window.userCategories = [];
  window.itemsByCategory = {};
  window.sortedItemsByCategory = {};
  window.fuseByCategory = {};
  window.categoryListeners = {};

  /**
   * Fetches all recurring items from history for shopping mode
   * @returns {Object} Object with category keys containing arrays of recurring items
   */
  async function getRecurringItemsForShopping() {
    if (!currentUser) return {};

    const recurringItems = {};

    try {
      // Initialize empty arrays for each category
      window.userCategories.forEach(category => {
        recurringItems[category.key] = [];
      });

      // Fetch recurring items from history
      const historySnapshot = await db.collection('users').doc(currentUser.uid).collection('item_history')
        .where('recurring', '==', true)
        .get();

      // Process and categorize recurring items
      historySnapshot.forEach(doc => {
        const data = doc.data();
        const category = data.category;
        if (recurringItems[category]) {
          recurringItems[category].push({
            id: `history_${doc.id}`,
            name: data.name,
            duration: data.duration,
            recurring: true,
            quantity: 0 // Shopping items start with 0 quantity
          });
        }
      });

    } catch (error) {
      console.error("Error fetching recurring items from history:", error);
    }

    return recurringItems;
  }

  const firebaseConfig = {
    apiKey: "{{ site.env.FIREBASE_API_KEY }}",
    authDomain: "{{ site.env.FIREBASE_AUTH_DOMAIN }}",
    projectId: "{{ site.env.FIREBASE_PROJECT_ID }}",
    storageBucket: "{{ site.env.FIREBASE_STORAGE_BUCKET }}",
    messagingSenderId: "{{ site.env.FIREBASE_MESSAGING_SENDER_ID }}",
    appId: "{{ site.env.FIREBASE_APP_ID }}"
  };

  firebase.initializeApp(firebaseConfig);
  const auth = firebase.auth();
  const db = firebase.firestore();
  let currentUser;
  let categoriesListenerUnsubscribe = null;

  // DOM Element references for Auth
  const loginContainer = document.getElementById('login-container');
  const mainContent = document.getElementById('tabs');
  const tabContents = document.getElementById('tabsContents');

  const emailInput = document.getElementById('email');
  const passwordInput = document.getElementById('password');
  const loginBtn = document.getElementById('login-btn');
  const signupBtn = document.getElementById('signup-btn');
  const logoutBtn = document.getElementById('logout-btn');
  const forgotPasswordBtn = document.getElementById('forgot-password-btn');

  // Sign up new users
  signupBtn.addEventListener('click', e => {
    const email = emailInput.value.trim();
    const password = passwordInput.value;
    auth.createUserWithEmailAndPassword(email, password)
      .then(userCredential => {
        // Signed in
      })
      .catch(error => {
        alert(error.message);
      });
  });

  // Login existing users
  loginBtn.addEventListener('click', e => {
    const email = emailInput.value.trim();
    const password = passwordInput.value;
    auth.signInWithEmailAndPassword(email, password)
      .then(userCredential => {
        // Signed in
      })
      .catch(error => {
        console.error('Sign in error:', error);
        alert(error.message);
      });
  });

  // Logout user
  logoutBtn.addEventListener('click', e => {
    auth.signOut().then(() => {
      // User logged out
    }).catch(error => {
      console.error('Sign out error:', error);
      alert(error.message);
    });
  });

  // Handle forgot password
  forgotPasswordBtn.addEventListener('click', () => {
    const email = emailInput.value;
    if (!email) {
      alert('Please enter your email address in the email field.');
      return;
    }

    auth.sendPasswordResetEmail(email)
      .then(() => {
        // Email sent.
        alert('Password reset email sent! Please check your inbox.');
      })
      .catch((error) => {
        // An error happened.
        alert(error.message);
        console.error('Error sending password reset email:', error);
      });
  });

  auth.onAuthStateChanged(async user => {
    const shoppingModeSwitch = document.getElementById('shopping-mode-switch');

    if (user) {
      // User is signed in. Show the main content.
      currentUser = user;
      loginContainer.style.display = 'none';
      mainContent.style.display = 'flex';
      tabContents.style.display = 'block';

      // Restore shopping mode state from localStorage
      const savedMode = localStorage.getItem('shoppingMode') === 'true';
      shoppingModeSwitch.checked = savedMode;

      // Listen for changes on the switch
      shoppingModeSwitch.addEventListener('change', async (e) => {
        localStorage.setItem('shoppingMode', e.target.checked);
        await updateDisplay(); // Re-render everything when mode changes
      });

      // Setup dynamic categories system
      categoriesListenerUnsubscribe = setupCategoriesListener();

    } else {
      // User is signed out. Show the login form.
      currentUser = null;
      loginContainer.style.display = 'block';
      mainContent.style.display = 'none';
      tabContents.style.display = 'none';

      // Clean up categories listener
      if (typeof categoriesListenerUnsubscribe === 'function') {
        categoriesListenerUnsubscribe();
        categoriesListenerUnsubscribe = null;
      }

      // Clean up category item listeners
      if (window.categoryListeners) {
        Object.values(window.categoryListeners).forEach(unsubscribe => {
          if (typeof unsubscribe === 'function') {
            unsubscribe();
          }
        });
        window.categoryListeners = {};
      }
    }

    // Reveal the content after the logic is complete
    document.body.classList.remove('is-loading');

    // Initialize expiry filter settings
    setTimeout(() => {
      ExpiryFilterSettings.initializeControls();
      NotificationManager.initializeControls();
    }, 100);
  });

  async function updateDisplay() {
    const isShoppingMode = document.getElementById('shopping-mode-switch').checked;

    // Clear hidden shopping items when switching to normal mode
    if (!isShoppingMode) {
      localStorage.removeItem('hiddenShoppingItems');
    }

    // Get all recurring items from history if in shopping mode
    let allRecurringItems = {};
    if (isShoppingMode) {
      allRecurringItems = await getRecurringItemsForShopping();
    }

    // Function to render a single category list
    const renderList = (categoryKey, fullList, categoryRecurringItems = []) => {
      const listElement = document.getElementById(`${categoryKey}-list`);
      if (!listElement) return;

      while (listElement.firstChild) {
        listElement.removeChild(listElement.firstChild);
      }

      let itemsToRender;

      if (isShoppingMode) {
        // Filter for recurring items from current pantry, exclude temporarily hidden ones
        const hiddenItems = JSON.parse(localStorage.getItem('hiddenShoppingItems') || '[]');
        const currentRecurringItems = fullList.filter(item => item.recurring && !hiddenItems.includes(item.name));

        // Merge current items with all recurring items from history
        const allItems = [...currentRecurringItems, ...categoryRecurringItems];

        // Filter out hidden items from the combined list
        const filteredItems = allItems.filter(item => !hiddenItems.includes(item.name));

        // Aggregate items by name, summing quantities
        const aggregatedItems = {};
        filteredItems.forEach(item => {
          if (aggregatedItems[item.name]) {
            aggregatedItems[item.name].quantity += parseInt(item.quantity || 0);
          } else {
            aggregatedItems[item.name] = {
              id: item.id || `shopping_${categoryKey}_${item.name}`,
              name: item.name,
              quantity: parseInt(item.quantity || 0),
              // Keep the first item's other properties for reference
              duration: item.duration,
              recurring: item.recurring
            };
          }
        });

        // Convert back to array and sort by quantity
        itemsToRender = Object.values(aggregatedItems).sort((a, b) => a.quantity - b.quantity);
      } else {
        // Normal mode: apply sorting and filtering preferences
        const sortBy = window.sortingPreferences[categoryKey] || 'date';
        const sortDirection = window.sortingDirections[categoryKey] || 'asc';
        const filterBy = window.filteringPreferences[categoryKey] || 'all';

        // Apply custom sorting
        const sortedItems = sortArrayBy(fullList, sortBy, sortDirection);

        // Apply filtering
        let filteredItems = filterItems(sortedItems, filterBy);

        // Apply expiry distance filtering if enabled
        const expirySettings = ExpiryFilterSettings.getSettings();
        const showHidden = window.showHiddenItems[categoryKey] || false;

        // Count distant items before filtering for toggle button visibility
        const distantItemsCount = countDistantItems(filteredItems, expirySettings.monthsThreshold);

        // Update toggle button visibility and text
        updateDistantItemsToggle(categoryKey, distantItemsCount, showHidden);

        // Apply expiry distance filter
        itemsToRender = filterItemsByExpiryDistance(
          filteredItems,
          expirySettings.monthsThreshold,
          expirySettings.enabled,
          showHidden
        );
      }

      if (itemsToRender.length === 0) {
        const li = document.createElement("li");
        li.classList.add("list-group-item");
        li.textContent = isShoppingMode ? "{{ page.shopping_list_empty }}" : "{{ page.no_items }}";
        listElement.appendChild(li);
        return;
      }

      for (const item of itemsToRender) {
        const li = document.createElement("li");
        li.id = `item-${item.id}`;
        li.setAttribute("data-item-id", item.id);

        if (isShoppingMode) {
          // --- SHOPPING MODE ITEM TEMPLATE ---
          li.innerHTML = `
            <div class="list-group-item d-flex justify-content-between align-items-center">
              <div>
                <div class="fw-bold">${item.name}</div>
                <small>Quantity: ${item.quantity}</small>
              </div>
              <div>
                <button class="btn btn-sm btn-outline-secondary me-2" title="Skip for now">
                  <i class="fa-solid fa-eye-slash"></i>
                </button>
                <button class="btn btn-sm btn-success" title="Add to pantry">
                  <i class="fa-solid fa-cart-plus"></i>
                </button>
              </div>
            </div>
          `;
          // Add event listeners for shopping buttons
          li.querySelector('.btn-outline-secondary').addEventListener('click', async () => {
            // Add item to hidden list in localStorage
            const hiddenItems = JSON.parse(localStorage.getItem('hiddenShoppingItems') || '[]');
            if (!hiddenItems.includes(item.name)) {
              hiddenItems.push(item.name);
              localStorage.setItem('hiddenShoppingItems', JSON.stringify(hiddenItems));
            }

            // Refresh the display to properly update the list and show empty message if needed
            await updateDisplay();
          });
          li.querySelector('.btn-success').addEventListener('click', () => {
            // Store reference to this shopping list item for later hiding
            window.currentShoppingItem = { element: li, name: item.name };

            // Open "Add Item" modal and pre-fill the name
            document.getElementById('add-item-modal-title').textContent = '{{ page.add_item }}';
            const nameInput = document.getElementById('new-item-name');
            nameInput.value = item.name;
            nameInput.dispatchEvent(new Event('change')); // Trigger history lookup
            new bootstrap.Modal(document.getElementById('add-item-modal')).show();
          });
        } else {
          // --- NORMAL MODE ITEM TEMPLATE ---
          li.innerHTML = `
            <button type="button" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" data-bs-toggle="modal" data-bs-target="#edit-item-modal" data-bs-id="${item.id}" data-category="${categoryKey}">
              <div class="d-flex align-items-center">
                <div class="ms-2 me-auto"><div class="fw-bold">${item.name}</div>${DateTime.fromISO(item.expiring_date).setLocale('{{ site.active_lang }}').toRelative()}</div>
              </div>
              <div class="d-flex align-items-center"><span class="badge text-bg-primary rounded-pill">${item.quantity}</span><span class="ms-2"><i class="fa-solid fa-chevron-right"></i></span></div>
            </button>
          `;
        }
        listElement.appendChild(li);
      }
      if (!isShoppingMode) {
        checkExpiryDates();
      }
    };

    // Render all category lists
    window.userCategories.forEach(category => {
      const categoryItems = window.sortedItemsByCategory[category.key] || [];
      const recurringItems = allRecurringItems[category.key] || [];
      renderList(category.key, categoryItems, recurringItems);
    });

    // Toggle filter visibility based on shopping mode
    toggleSortingFilteringVisibility(isShoppingMode);
  }

  // Function to generate tab content using template-like approach
  function generateTabContent(categoryKey, categoryName, tabIndex) {
    const isActive = tabIndex === 0 ? ' show active' : '';

    return `
      <div class="input-group my-3" id="${categoryKey}-search-container">
        <input type="search" class="form-control" id="${categoryKey}-search-input" placeholder="{{ page.search }} ${categoryName.toLowerCase()}..." aria-label="{{ page.search }} ${categoryName.toLowerCase()}">
      </div>

      <!-- Sorting and Filtering Controls -->
      <div class="d-flex flex-wrap gap-2 mb-3 sorting-filtering-controls">
        <!-- Sorting Dropdown -->
        <div class="dropdown">
          <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" id="${categoryKey}-sort-dropdown" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="fa-solid fa-sort"></i> {{ page.sort_by }}
          </button>
          <ul class="dropdown-menu" aria-labelledby="${categoryKey}-sort-dropdown">
            <li><h6 class="dropdown-header">{{ page.sort_by_date }}</h6></li>
            <li><a class="dropdown-item sort-option" href="#" data-sort="date" data-direction="asc" data-category="${categoryKey}">
              <i class="fa-solid fa-calendar"></i> {{ page.sort_by_date }} <i class="fa-solid fa-arrow-up"></i>
            </a></li>
            <li><a class="dropdown-item sort-option" href="#" data-sort="date" data-direction="desc" data-category="${categoryKey}">
              <i class="fa-solid fa-calendar"></i> {{ page.sort_by_date }} <i class="fa-solid fa-arrow-down"></i>
            </a></li>
            <li><hr class="dropdown-divider"></li>
            <li><h6 class="dropdown-header">{{ page.sort_by_name }}</h6></li>
            <li><a class="dropdown-item sort-option" href="#" data-sort="name" data-direction="asc" data-category="${categoryKey}">
              <i class="fa-solid fa-font"></i> {{ page.sort_by_name }} <i class="fa-solid fa-arrow-up"></i>
            </a></li>
            <li><a class="dropdown-item sort-option" href="#" data-sort="name" data-direction="desc" data-category="${categoryKey}">
              <i class="fa-solid fa-font"></i> {{ page.sort_by_name }} <i class="fa-solid fa-arrow-down"></i>
            </a></li>
            <li><hr class="dropdown-divider"></li>
            <li><h6 class="dropdown-header">{{ page.sort_by_quantity }}</h6></li>
            <li><a class="dropdown-item sort-option" href="#" data-sort="quantity" data-direction="asc" data-category="${categoryKey}">
              <i class="fa-solid fa-hashtag"></i> {{ page.sort_by_quantity }} <i class="fa-solid fa-arrow-up"></i>
            </a></li>
            <li><a class="dropdown-item sort-option" href="#" data-sort="quantity" data-direction="desc" data-category="${categoryKey}">
              <i class="fa-solid fa-hashtag"></i> {{ page.sort_by_quantity }} <i class="fa-solid fa-arrow-down"></i>
            </a></li>
          </ul>
        </div>

        <!-- Filter Buttons (hidden in shopping mode) -->
        <div class="btn-group filter-buttons" role="group" aria-label="Filter options" id="${categoryKey}-filter-container">
          <input type="radio" class="btn-check filter-option" name="${categoryKey}-filter" id="${categoryKey}-filter-all" data-filter="all" data-category="${categoryKey}" checked>
          <label class="btn btn-outline-primary btn-sm" for="${categoryKey}-filter-all">{{ page.all_items }}</label>

          <input type="radio" class="btn-check filter-option" name="${categoryKey}-filter" id="${categoryKey}-filter-opened" data-filter="opened" data-category="${categoryKey}">
          <label class="btn btn-outline-primary btn-sm" for="${categoryKey}-filter-opened">{{ page.opened_items }}</label>

          <input type="radio" class="btn-check filter-option" name="${categoryKey}-filter" id="${categoryKey}-filter-unopened" data-filter="unopened" data-category="${categoryKey}">
          <label class="btn btn-outline-primary btn-sm" for="${categoryKey}-filter-unopened">{{ page.unopened_items }}</label>
        </div>

        <!-- Show/Hide Distant Items Toggle (hidden in shopping mode) -->
        <button class="btn btn-outline-info btn-sm" type="button" id="${categoryKey}-distant-items-toggle" style="display: none;" data-category="${categoryKey}">
          <i class="fa-solid fa-eye"></i> <span class="toggle-text">{{ page.show_hidden_items }}</span>
        </button>
      </div>

      <ul class="list-group list-group-flush list-unstyled mt-3" id="${categoryKey}-list"></ul>

      <!-- Floating add item button -->
      <div class="fixed-action-btn" style="height: 80px;">
        <button class="btn btn-floating text-white btn-lg" aria-label="{{ page.add_item }}" style="background-color: #f44336;" data-bs-toggle="modal" data-bs-target="#add-item-modal">
          <i class="fa-solid fa-plus"></i>
        </button>
      </div>
    `;
  }

  // Functions to handle dynamic category system
  function updateCategoryTabs() {
    const tabsContainer = document.querySelector('#tabs ul.nav-tabs');
    const tabContentsContainer = document.getElementById('tabsContents');

    if (!tabsContainer || !tabContentsContainer) return;

    // Remember which tab was active before rebuilding
    const currentActiveTab = document.querySelector('.nav-link.active');
    const activeTabId = currentActiveTab ? currentActiveTab.id : null;

    // Store references to options tab and content before clearing
    const optionsTab = tabsContainer.querySelector('#options-tab')?.parentElement;
    const optionsTabContent = tabContentsContainer.querySelector('#options-tab-pane');

    // Clear all tabs and contents
    tabsContainer.innerHTML = '';
    tabContentsContainer.innerHTML = '';

    // Create tabs for each category
    window.userCategories.forEach((category, index) => {
      // Create tab
      const li = document.createElement('li');
      li.className = 'nav-item';
      li.setAttribute('role', 'presentation');

      const isActive = activeTabId === `${category.key}-tab` || (index === 0 && !activeTabId);

      const button = document.createElement('button');
      button.className = `nav-link ${isActive ? 'active' : ''}`;
      button.id = `${category.key}-tab`;
      button.setAttribute('data-bs-toggle', 'tab');
      button.setAttribute('data-bs-target', `#${category.key}-tab-pane`);
      button.setAttribute('data-category', category.key);
      button.setAttribute('type', 'button');
      button.setAttribute('role', 'tab');
      button.setAttribute('aria-controls', `${category.key}-tab-pane`);
      button.setAttribute('aria-selected', isActive ? 'true' : 'false');

      // Create emoji and name elements for better mobile display
      const emoji = category.emoji || '📦';
      const emojiSpan = document.createElement('span');
      emojiSpan.className = 'category-emoji';
      emojiSpan.textContent = emoji;

      const nameSpan = document.createElement('span');
      nameSpan.className = 'category-name';
      nameSpan.textContent = category.name;

      button.appendChild(emojiSpan);
      button.appendChild(nameSpan);

      li.appendChild(button);
      tabsContainer.appendChild(li);

      // Create tab content using template-like function
      const tabPane = document.createElement('div');
      tabPane.className = `tab-pane fade ${isActive ? 'show active' : ''}`;
      tabPane.id = `${category.key}-tab-pane`;
      tabPane.setAttribute('role', 'tabpanel');
      tabPane.setAttribute('aria-labelledby', `${category.key}-tab`);
      tabPane.setAttribute('tabindex', index.toString());

      // Use the template function to generate content
      tabPane.innerHTML = generateTabContent(category.key, category.name, index);

      tabContentsContainer.appendChild(tabPane);
    });

    // Add options tab at the end
    if (optionsTab) {
      // Ensure options tab is not active unless it was specifically active before
      const optionsButton = optionsTab.querySelector('#options-tab');
      if (optionsButton) {
        const optionsIsActive = activeTabId === 'options-tab';
        optionsButton.className = `nav-link ${optionsIsActive ? 'active' : ''}`;
        optionsButton.setAttribute('aria-selected', optionsIsActive ? 'true' : 'false');
      }
      tabsContainer.appendChild(optionsTab);
    }

    // Add options tab content at the end
    if (optionsTabContent) {
      // Ensure options content matches the tab state
      const optionsIsActive = activeTabId === 'options-tab';
      optionsTabContent.className = `tab-pane fade ${optionsIsActive ? 'show active' : ''}`;
      tabContentsContainer.appendChild(optionsTabContent);
    }

    // Update categories management list and dropdown
    updateCategoriesList();
    updateCategoryDropdown();

    // Category tabs have been updated
  }

  function setupCategoryListeners() {
    // Clean up existing listeners
    Object.values(window.categoryListeners).forEach(unsubscribe => {
      if (typeof unsubscribe === 'function') {
        unsubscribe();
      }
    });
    window.categoryListeners = {};

    // Setup listeners for each category
    window.userCategories.forEach(category => {
      const unsubscribe = setupRealtimeListener(category.key);
      window.categoryListeners[category.key] = unsubscribe;

      // Setup search for this category
      const searchInput = document.getElementById(`${category.key}-search-input`);
      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          handleCategorySearch(e.target.value, category.key);
        });
      }
    });
  }

  // Function to update distant items toggle button
  function updateDistantItemsToggle(categoryKey, hiddenCount, showHidden) {
    const toggleButton = document.getElementById(`${categoryKey}-distant-items-toggle`);
    if (!toggleButton) {
      return; // Button might not be created yet, that's okay
    }

    const expirySettings = ExpiryFilterSettings.getSettings();

    if (hiddenCount > 0 && expirySettings.enabled) {
      toggleButton.style.display = 'block';
      // <i class="fa-solid fa-eye"></i> <span class="toggle-text">{{ page.show_hidden_items }}</span>

      if (showHidden) {
        toggleButton.innerHTML = `<i class="fa-solid fa-eye-slash"></i> <span class="toggle-text">{{ page.hide_hidden_items }} (${hiddenCount})</span>`;
      } else {
        toggleButton.innerHTML = `<i class="fa-solid fa-eye"></i> <span class="toggle-text">{{ page.show_hidden_items }} (${hiddenCount})</span>`;
      }
    } else {
      toggleButton.style.display = 'none';
    }
  }

  function handleCategorySearch(searchTerm, categoryKey) {
    const listElement = document.getElementById(`${categoryKey}-list`);
    if (!listElement) return;

    const allItems = listElement.querySelectorAll('li[data-item-id]');

    if (!searchTerm) {
      allItems.forEach(li => li.style.display = ''); // Show all
      return;
    }

    const fuseInstance = window.fuseByCategory[categoryKey];
    if (!fuseInstance) return;

    const results = fuseInstance.search(searchTerm);
    const matchingIds = new Set(results.map(result => result.item.id));

    allItems.forEach(li => {
      const itemId = li.getAttribute('data-item-id');
      if (matchingIds.has(itemId)) {
        li.style.display = ''; // Show match
      } else {
        li.style.display = 'none'; // Hide non-match
      }
    });
  }

  // Event handlers for sorting and filtering controls
  document.addEventListener('DOMContentLoaded', function() {
    // Sort option click handlers
    document.addEventListener('click', function(e) {
      if (e.target.classList.contains('sort-option') || e.target.closest('.sort-option')) {
        e.preventDefault();
        const sortOption = e.target.classList.contains('sort-option') ? e.target : e.target.closest('.sort-option');
        const sortBy = sortOption.getAttribute('data-sort');
        const direction = sortOption.getAttribute('data-direction');
        const categoryKey = sortOption.getAttribute('data-category');

        // Store preferences
        window.sortingPreferences[categoryKey] = sortBy;
        window.sortingDirections[categoryKey] = direction;

        // Update button text to show current selection
        const dropdown = document.getElementById(`${categoryKey}-sort-dropdown`);
        const icon = sortBy === 'date' ? 'fa-calendar' :
                    sortBy === 'name' ? 'fa-font' : 'fa-hashtag';
        const text = sortBy === 'date' ? '{{ page.sort_by_date }}' :
                    sortBy === 'name' ? '{{ page.sort_by_name }}' : '{{ page.sort_by_quantity }}';
        const directionIcon = direction === 'asc' ? 'fa-arrow-up' : 'fa-arrow-down';
        dropdown.innerHTML = `<i class="fa-solid ${icon}"></i> ${text} <i class="fa-solid ${directionIcon}"></i>`;

        // Refresh display
        updateDisplay();
      }
    });

    // Filter option change handlers
    document.addEventListener('change', function(e) {
      if (e.target.classList.contains('filter-option')) {
        const filterBy = e.target.getAttribute('data-filter');
        const categoryKey = e.target.getAttribute('data-category');

        // Store preference
        window.filteringPreferences[categoryKey] = filterBy;

        // Refresh display
        updateDisplay();
      }
    });

    // Handle shopping mode toggle to show/hide filters
    const shoppingModeSwitch = document.getElementById('shopping-mode-switch');
    if (shoppingModeSwitch) {
      shoppingModeSwitch.addEventListener('change', function() {
        toggleSortingFilteringVisibility(this.checked);
      });
    }

    // Distant items toggle handlers
    document.addEventListener('click', function(e) {
      // Check if the clicked element is the toggle button or a child of it
      let toggleButton = null;

      if (e.target.id && e.target.id.endsWith('-distant-items-toggle')) {
        // Direct click on the button
        toggleButton = e.target;
      } else if (e.target.parentElement && e.target.parentElement.id && e.target.parentElement.id.endsWith('-distant-items-toggle')) {
        // Click on a child element (icon or span)
        toggleButton = e.target.parentElement;
      }

      if (toggleButton) {
        const categoryKey = toggleButton.getAttribute('data-category');

        // Toggle the show hidden state for this category
        window.showHiddenItems[categoryKey] = !window.showHiddenItems[categoryKey];

        // Refresh display
        updateDisplay();
      }
    });
  });

  // Function to toggle filter visibility based on shopping mode
  function toggleSortingFilteringVisibility(isShoppingMode) {
    window.userCategories.forEach(category => {
      const filterContainer = document.getElementById(`${category.key}-filter-container`);
      if (filterContainer) {
        filterContainer.style.display = isShoppingMode ? 'none' : 'flex';
      }

      const distantToggle = document.getElementById(`${category.key}-distant-items-toggle`);
      if (distantToggle) {
        distantToggle.style.display = isShoppingMode ? 'none' : distantToggle.style.display;
      }
    });
    window.userCategories.forEach(category => {
      const sortDropdown = document.getElementById(`${category.key}-sort-dropdown`);
      if (sortDropdown) {
        sortDropdown.style.display = isShoppingMode ? 'none' : 'block';
      }
    });
  }

  {% include scripts/utils.js.liquid %}
  {% include scripts/ui.js.liquid %}
  {% include scripts/db.js.liquid %}
</script>
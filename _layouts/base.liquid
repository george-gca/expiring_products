<!DOCTYPE html>
<html lang="{{ site.active_lang }}" data-mdb-theme="dark">
<head>
  {% include head.liquid %}
</head>

<!-- https://fastbootstrap.com/docs/margin/-->
<body class="m-4 is-loading">
  {% include github_corner.liquid %}

  <h1>{{ page.products_to_expire }}</h1>

  <div id="login-container">
    <input type="email" id="email" placeholder="Email">
    <input type="password" id="password" placeholder="Password">
    <button id="login-btn">Login</button>
    <button id="signup-btn">Sign Up</button>
    <button id="forgot-password-btn" class="btn btn-link">Forgot Password?</button>
  </div>

  <div class="d-flex justify-content-between align-items-center border-bottom" id="tabs">
    <ul class="nav nav-tabs" role="tablist">
      <!-- Category tabs will be generated dynamically -->
      <li class="nav-item" role="presentation">
        <button class="nav-link" id="options-tab" data-bs-toggle="tab" data-bs-target="#options-tab-pane" type="button" role="tab" aria-controls="options-tab-pane" aria-selected="false">
          <i class="fa-solid fa-cog"></i> <span class="d-none d-sm-inline">{{ page.options }}</span>
        </button>
      </li>
    </ul>
    <div class="mb-2">
      <div class="shopping-mode-container">
        <span class="shopping-mode-emoji">🛒</span>
        <div class="form-check form-switch">
          <input class="form-check-input" type="checkbox" role="switch" id="shopping-mode-switch">
          <label class="form-check-label shopping-mode-text" for="shopping-mode-switch">{{ page.shopping_mode }}</label>
        </div>
      </div>
    </div>
  </div>

  <div class="tab-content" id="tabsContents">
    <!-- Category tab contents will be generated dynamically -->
    {% include settings_tab.liquid %}
  </div>

  {%  include edit_item_modal.liquid %}
  {%  include add_item_modal.liquid %}

  {% include external_scripts.liquid %}
  {% include script.liquid %}
</body>
</html>
